diff --git a/src/client/shell/render.rs b/src/client/shell/render.rs
index 248216c1..018d387d 100644
--- a/src/client/shell/render.rs
+++ b/src/client/shell/render.rs
@@ -372,6 +372,98 @@ pub(super) fn put_text(buffer: &mut Buffer, x: u16, y: u16, width: u16, text: &s
     buffer.set_stringn(x, y, text, width as usize, style);
 }
 
+/// Local build: section heading drawn as ` TITLE ───── N`.
+///
+/// `reserved_right` keeps columns free at the right edge for a control that
+/// shares the heading row. The rule and the count drop out when they no
+/// longer fit, so a narrow sidebar still shows the title.
+#[allow(clippy::too_many_arguments)]
+pub(super) fn put_section_heading(
+    buffer: &mut Buffer,
+    x: u16,
+    y: u16,
+    width: u16,
+    title: &str,
+    count: usize,
+    color: ratatui::style::Color,
+    reserved_right: u16,
+) {
+    let avail = width.saturating_sub(reserved_right);
+    let title_text = format!(" {title}");
+    let bold = Style::default()
+        .fg(color)
+        .add_modifier(ratatui::style::Modifier::BOLD);
+    put_text(buffer, x, y, avail, &title_text, bold);
+
+    let count_text = count.to_string();
+    let title_width = display_width(&title_text);
+    let count_width = display_width(&count_text);
+    // title, a space, at least one rule cell, a space, the count
+    let Some(rule_width) = avail.checked_sub(title_width + count_width + 2) else {
+        return;
+    };
+    if rule_width == 0 {
+        return;
+    }
+    put_text(
+        buffer,
+        x + title_width + 1,
+        y,
+        rule_width,
+        &"─".repeat(rule_width as usize),
+        Style::default()
+            .fg(color)
+            .add_modifier(ratatui::style::Modifier::DIM),
+    );
+    put_text(
+        buffer,
+        x + avail - count_width,
+        y,
+        count_width,
+        &count_text,
+        bold,
+    );
+}
+
 pub(super) fn display_width(text: &str) -> u16 {
     UnicodeWidthStr::width(text).min(u16::MAX as usize) as u16
 }
+
+#[cfg(test)]
+mod section_heading_tests {
+    use super::*;
+
+    fn heading(width: u16, reserved_right: u16) -> String {
+        let area = Rect::new(0, 0, width, 1);
+        let mut buffer = Buffer::empty(area);
+        put_section_heading(
+            &mut buffer,
+            0,
+            0,
+            width,
+            "AGENTS",
+            12,
+            ratatui::style::Color::Blue,
+            reserved_right,
+        );
+        (0..width)
+            .map(|x| buffer[(x, 0)].symbol().to_owned())
+            .collect()
+    }
+
+    #[test]
+    fn heading_fills_the_row_with_title_rule_and_count() {
+        assert_eq!(heading(20, 0), " AGENTS ───────── 12");
+    }
+
+    #[test]
+    fn heading_keeps_reserved_columns_free_on_the_right() {
+        assert_eq!(heading(20, 8), " AGENTS ─ 12        ");
+    }
+
+    #[test]
+    fn heading_drops_rule_and_count_when_they_do_not_fit() {
+        assert_eq!(heading(10, 0), " AGENTS   ");
+        assert_eq!(heading(4, 0), " AGE");
+    }
+}
